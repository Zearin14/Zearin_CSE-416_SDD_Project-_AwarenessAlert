{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.unit.config.ts",
    "related": false
  },
  "mutate": [
    "src/logic.ts"
  ],
  "reporters": [
    "clear-text",
    "html",
    "json",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "docs/testing/evidence/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "docs/testing/evidence/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "coverageAnalysis": "perTest"
}